{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["question", "oracle"],
  "properties": {
    "question": {
      "type": "object",
      "required": ["kind", "text"],
      "properties": {
        "kind": { "enum": ["threshold", "range"] },
        "text": { "type": "string" }
      },
      "additionalProperties": true
    },
    "oracle": {
      "type": "object",
      "required": ["venue"],
      "properties": {
        "venue": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
