# Copy to .env.acceptance for the Docker release-acceptance gate.

# Required: keystore password used inside the acceptance container.
JINN_PASSWORD=replace-with-a-strong-password

# Optional: override the repo's BASE_SEPOLIA_RPC_URL for acceptance only.
# JINN_TESTNET_ACCEPTANCE_RPC_URL=https://base-sepolia.gateway.tenderly.co/...

# Required: Claude OAuth token for Docker (run `claude setup-token` on your host).
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# Optional acceptance-specific overrides.
# JINN_TESTNET_ACCEPTANCE_CLAUDE_MODEL=claude-haiku-4-5-20251001
# JINN_TESTNET_ACCEPTANCE_POLL_INTERVAL_MS=5000
# JINN_TESTNET_ACCEPTANCE_TARGET_SERVICES=1
# JINN_ACCEPTANCE_IMAGE=jinn-client:acceptance-local
