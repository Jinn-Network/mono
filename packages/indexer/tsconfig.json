{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node"]
  },
  "include": [
    "ponder-env.d.ts",
    "src/**/*",
    "abis/**/*",
    "ponder.config.ts",
    "ponder.schema.ts",
    "test/**/*"
  ]
}
