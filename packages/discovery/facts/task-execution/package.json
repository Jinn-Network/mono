{
  "name": "@jinn-network/record-discovery-facts-task-execution",
  "version": "0.1.0",
  "description": "Facts-profile documents and record-fact recompute functions for the Jinn Task Execution Protocol record-kind tree (Task, Submission, Delivery, profile document, evaluation spec, plugin, checkpoint).",
  "type": "module",
  "packageManager": "yarn@4.13.0",
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jinn-Network/mono.git",
    "directory": "packages/discovery/facts/task-execution"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./profiles/*": "./profiles/*"
  },
  "files": [
    "dist/",
    "profiles/",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "pack:smoke": "node scripts/pack-smoke.mjs",
    "prepack": "yarn build"
  },
  "dependencies": {
    "@jinn-network/record-discovery-protocol": "0.1.0",
    "@jinn-network/task-execution-profiles": "0.1.0",
    "@jinn-network/task-execution-protocol": "0.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@jinn-network/trust-core": "0.1.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  },
  "resolutions": {
    "@jinn-network/record-discovery-protocol": "portal:../../protocol",
    "@jinn-network/task-execution-profiles": "portal:../../../task-execution/profiles",
    "@jinn-network/task-execution-protocol": "portal:../../../task-execution/protocol",
    "@jinn-network/trust-core": "portal:../../../trust/core"
  }
}
