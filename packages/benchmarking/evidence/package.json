{
  "name": "@jinn-network/benchmarking-evidence",
  "version": "0.1.0",
  "description": "TEP-free evidence cohort verification and Matrix v2 assembly.",
  "type": "module",
  "packageManager": "yarn@4.13.0",
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jinn-Network/mono.git",
    "directory": "packages/benchmarking/evidence"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "prepack": "yarn build"
  },
  "dependencies": {
    "@jinn-network/benchmarking-aggregate": "0.1.0",
    "@jinn-network/benchmarking-protocol": "0.1.0",
    "@jinn-network/evidence-protocol": "0.1.0",
    "@jinn-network/trust-core": "0.1.0"
  },
  "peerDependencies": {
    "vitest": "^4.1.8"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@jinn-network/execution-evidence-builder": "0.1.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  },
  "resolutions": {
    "@jinn-network/benchmarking-aggregate": "portal:../aggregate",
    "@jinn-network/benchmarking-records": "portal:../records",
    "@jinn-network/benchmarking-protocol": "portal:../protocol",
    "@jinn-network/evidence-protocol": "portal:../../evidence/protocol",
    "@jinn-network/trust-core": "portal:../../trust/core",
    "@jinn-network/task-execution-protocol": "portal:../../task-execution/protocol",
    "@jinn-network/execution-evidence-builder": "portal:../../evidence/execution-evidence-builder"
  }
}
