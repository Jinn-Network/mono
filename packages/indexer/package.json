{
  "name": "@jinn-network/indexer",
  "version": "0.1.0",
  "description": "Ponder indexer for the Jinn protocol — four-entity schema (Task, Attempt, SolverNetManifest, Envelope) with a GraphQL→DiscoveryAPI adapter.",
  "type": "module",
  "packageManager": "yarn@4.13.0",
  "license": "MIT",
  "exports": {
    "./schema": "./ponder.schema.ts",
    "./enrichment-parse": "./src/enrichment-parse.ts",
    "./ipfs": "./src/ipfs.ts"
  },
  "scripts": {
    "dev": "ponder dev",
    "build:explorer": "cd explorer && yarn install && yarn build",
    "build": "ponder codegen && yarn build:explorer",
    "start": "ponder start",
    "serve": "ponder serve",
    "codegen": "ponder codegen",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "resolutions": {
    "@hono/node-server": "^2.1.1",
    "@jinn-network/task-execution-protocol": "portal:../task-execution/protocol",
    "@jinn-network/trust-core": "portal:../trust/core",
    "drizzle-orm": "^0.45.2",
    "kysely": "^0.28.17"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@jinn-network/benchmarking-records": "portal:../benchmarking/records",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.2",
    "ponder": "^0.17.6",
    "viem": "^2.55.16"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.10"
  }
}
