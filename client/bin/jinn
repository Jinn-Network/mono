#!/usr/bin/env sh
# Thin launcher: exec tsx on the TypeScript entry living next to this file.
# Works when the client is installed via `yarn install` or `npm install` (the
# package.json `bin` field creates a symlink to this script).
SCRIPT="$0"
while [ -L "$SCRIPT" ]; do
  LINK="$(readlink "$SCRIPT")"
  case "$LINK" in
    /*) SCRIPT="$LINK" ;;
    *) SCRIPT="$(dirname "$SCRIPT")/$LINK" ;;
  esac
done
DIR="$(cd "$(dirname "$SCRIPT")" && pwd)"
exec tsx "$DIR/jinn.ts" "$@"
