#!/bin/sh
# jinn-agent — the Jinn harness. Single human-facing entrypoint.
#
# State isolation: jinn-agent keeps its own home (~/.jinn-agent) so it never
# collides with a stock install of the upstream agent (~/.hermes) — separate
# config, auth, skills, memories, sessions. Override with JINN_AGENT_HOME, or
# set HERMES_HOME explicitly to share state with a stock install on purpose.
if [ -z "$HERMES_HOME" ]; then
  export HERMES_HOME="${JINN_AGENT_HOME:-$HOME/.jinn-agent}"
fi
# The agent must run in the directory the user invoked jinn-agent from
# (mono#1369) — remember it before cd'ing into the repo for the setup steps.
USER_PWD="$PWD"
# Resolve $0 through symlinks before deriving the repo root (mono#1377) —
# setup.sh installs a ~/.local/bin/jinn-agent symlink, and dirname'ing the
# symlink path would put the "repo root" in ~/.local. POSIX-portable
# (no readlink -f), handles relative targets and chains.
SELF=$0
while [ -L "$SELF" ]; do
  DIR=$(cd "$(dirname "$SELF")" && pwd)
  TARGET=$(readlink "$SELF")
  case $TARGET in /*) SELF=$TARGET ;; *) SELF="$DIR/$TARGET" ;; esac
done
cd "$(dirname "$SELF")/.."
# Repo root for the ensure-block below (skin file lives in the repo).
export JINN_AGENT_REPO="$PWD"
# The Jinn plugin resolves its harness identity from these; unset (stock host)
# it honestly reports the host. The fork asserts its own identity here.
export JINN_HARNESS_NAME="jinn-agent"
export JINN_CLI_NAME="jinn-agent"
# Prefer the repo-local venv the installer creates; fall back to system python.
PY="python3"
if [ -x "venv/bin/python" ]; then
  PY="$JINN_AGENT_REPO/venv/bin/python"
fi
# The upstream core loads standalone plugins opt-in via `plugins.enabled` in
# $HERMES_HOME/config.yaml. The Jinn layer is this fork's point, so ensure it
# is enabled on every launch — idempotent, additive, and it respects an
# explicit user opt-out via `plugins.disabled`. The same block installs the
# jinn skin and defaults fresh installs to it (mono#1358) — an explicit user
# skin choice is never overwritten.
"$PY" - <<'PYEOF'
import os
from pathlib import Path
try:
    import yaml
except Exception:  # pyyaml unavailable (pre-setup run) — the core would not start anyway
    raise SystemExit(0)

home = Path(os.environ["HERMES_HOME"]).expanduser()
home.mkdir(parents=True, exist_ok=True)

# Skin install — config-independent (runs even under a plugin opt-out) so
# the jinn-agent look never depends on the plugin. Sync whenever the
# installed copy differs from the repo copy — the repo copy is canonical,
# so local edits to skins/jinn.yaml are overwritten (customise under a
# different skin name). Never block launch on a cosmetic failure.
src = Path(os.environ.get("JINN_AGENT_REPO", ".")) / "plugins" / "jinn" / "skin" / "jinn.yaml"
if src.is_file():
    try:
        content = src.read_text(encoding="utf-8")
        dest = home / "skins" / "jinn.yaml"
        if not dest.is_file() or dest.read_text(encoding="utf-8") != content:
            dest.parent.mkdir(parents=True, exist_ok=True)
            dest.write_text(content, encoding="utf-8")
    except Exception:
        pass

# Fork soul — identity template (mono#1386). Without it, the upstream core's
# first-run seeding writes its own brand identity ("You are Hermes Agent, ...
# created by Nous Research.") as the live identity prompt. Installed ONLY
# when SOUL.md is absent — unlike the skin sync above (repo copy canonical,
# always re-synced), the soul is the user's editable identity file, so an
# existing SOUL.md is NEVER overwritten, whether user-written or seeded by
# an earlier run. This block runs before the core, so on a fresh home this
# template wins; the core's seeding leaves an existing non-template SOUL.md
# untouched (hermes_cli/config.py _ensure_default_soul_md).
soul_src = Path(os.environ.get("JINN_AGENT_REPO", ".")) / "plugins" / "jinn" / "soul" / "SOUL.md"
soul_dest = home / "SOUL.md"
if soul_src.is_file() and not soul_dest.exists():
    try:
        soul_dest.write_text(soul_src.read_text(encoding="utf-8"), encoding="utf-8")
    except Exception:
        pass

path = home / "config.yaml"
config = {}
if path.exists():
    try:
        config = yaml.safe_load(path.read_text(encoding="utf-8")) or {}
    except Exception:
        raise SystemExit(0)  # never touch a broken config — the core surfaces the error
if not isinstance(config, dict):
    raise SystemExit(0)

changed = False

# 1. Plugin enablement — skipped per plugin on explicit user opt-out via
#    `plugins.disabled`, so the branding defaults below still apply.
plugins = config.setdefault("plugins", {})
if not isinstance(plugins, dict):
    raise SystemExit(0)
disabled = plugins.get("disabled") or []
if not isinstance(disabled, list):
    disabled = []
enabled = plugins.get("enabled")
if not isinstance(enabled, list):
    enabled = []
default_plugins = ["jinn", "local-trace-distiller"]
for plugin_name in default_plugins:
    disabled_aliases = {plugin_name, plugin_name.replace("-", "_")}
    if any(alias in disabled for alias in disabled_aliases):
        continue
    if plugin_name not in enabled:
        enabled.append(plugin_name)
        changed = True
if enabled != plugins.get("enabled"):
    plugins["enabled"] = enabled
    changed = True

# 2. Default skin — set only when the user has no explicit choice.
display = config.get("display")
if not isinstance(display, dict):
    display = {}
    config["display"] = display
skin = display.get("skin")
if not (isinstance(skin, str) and skin.strip()):
    display["skin"] = "jinn"
    changed = True

# 3. Upstream's OpenClaw-residue first-run hint is meaningless on this fork
#    (state lives in ~/.jinn-agent, `hermes claw migrate` is upstream-only).
onboarding = config.get("onboarding")
if not isinstance(onboarding, dict):
    onboarding = {}
    config["onboarding"] = onboarding
seen = onboarding.get("seen")
if not isinstance(seen, dict):
    seen = {}
    onboarding["seen"] = seen
if not seen.get("openclaw_residue_cleanup"):
    seen["openclaw_residue_cleanup"] = True
    changed = True

if changed:
    path.write_text(yaml.safe_dump(config, sort_keys=False), encoding="utf-8")
PYEOF
# Return to the invoking directory before exec — sessions run where the
# user launched jinn-agent, never inside the repo clone (mono#1369).
cd "$USER_PWD"
# Dispatch through the hermes console entry (hermes_cli.main) — the only
# surface carrying the full CLI: subcommands (setup, status, doctor, …) and
# the non-interactive single-query flags (chat -q PROMPT -Q --yolo). The
# bare TUI parser reached by exec'ing the top-level script directly has
# none of those (mono#1361).
for ENV_DIR in venv .venv; do
  if [ -x "$JINN_AGENT_REPO/$ENV_DIR/bin/hermes" ]; then
    exec "$JINN_AGENT_REPO/$ENV_DIR/bin/hermes" "$@"
  fi
done
exec "$PY" -c 'import os, sys; sys.path.insert(0, os.environ["JINN_AGENT_REPO"]); from hermes_cli.main import main; sys.exit(main())' "$@"
