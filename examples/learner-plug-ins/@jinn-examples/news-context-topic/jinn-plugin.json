{
  "schemaVersion": "1.0.0",
  "name": "@jinn-examples/news-context-topic",
  "version": "0.1.0",
  "description": "Adds a news-context topic to the claude-code-learner Orient phase for prediction.v0 intents.",
  "compatibility": {
    "claudeCodeLearner": ">=0.1.0 <0.2.0",
    "supportedKinds": ["prediction.v0"]
  },
  "slots": [
    {
      "type": "topic-explorer",
      "phase": "orient",
      "topic": "news-context",
      "scope": { "matchKinds": ["prediction.v0"] },
      "entry": "agents/news-context-explorer.md"
    }
  ],
  "license": "MIT"
}
