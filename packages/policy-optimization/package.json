{
  "name": "@jinn-network/policy-optimization",
  "version": "0.1.0",
  "description": "The Policy Optimization product: the sealed campaign document and its append-only lifecycle journal.",
  "type": "module",
  "packageManager": "yarn@4.13.0",
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jinn-Network/mono.git",
    "directory": "packages/policy-optimization"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "publishConfig": {
    "access": "restricted"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "pack:smoke": "node scripts/pack-smoke.mjs",
    "prepack": "yarn build"
  },
  "dependencies": {
    "@jinn-network/benchmarking-records": "0.1.0",
    "@jinn-network/policy-identity": "0.1.0",
    "zod": "4.4.3"
  },
  "resolutions": {
    "@jinn-network/benchmarking-records": "portal:../benchmarking/records",
    "@jinn-network/policy-identity": "portal:../policy/identity",
    "@jinn-network/task-execution-protocol": "portal:../task-execution/protocol"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
