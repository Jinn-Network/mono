.worktrees/
node_modules/
.local/

# .claude/ is operator-local (settings.json, worktrees, DS_Store) by default,
# but shareable skill prose lives at .claude/skills/<name>/SKILL.md and must
# be tracked so every contributor's Claude Code instance auto-discovers it
# (jinn-mono-2cl.15). Sub-paths inside .claude/skills/ that are themselves
# operator-local (e.g. cached state files) can be added back here with
# explicit .claude/skills/<name>/<path> ignore rules.
# Cursor/Codex: .cursor/skills/ and .codex/skills/ are symlinks into
# .claude/skills/ — run ./scripts/sync-skills.sh after adding a skill.
.claude/*
!.claude/skills/

# Beads / Dolt files (added by bd init)
.beads
.beads.pre-helm-*/
.dolt/
*.db
.beads-credential-key

# Per-operator dev helpers (not collaborative)
client/start-daemon.sh

# Per-operator Claude context (personal profile, not collaborative)
CLAUDE.local.md

# macOS
.DS_Store

# Growth recruitment materials (not collaborative / contains PII)
growth/docs/initial-network-recruitment/
growth/docs/Initial Network Recruitment-handoff.zip
growth/docs/Intro to Jinn*.pdf
growth/skills/
growth/.local/

