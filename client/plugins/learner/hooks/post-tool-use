#!/usr/bin/env python3
"""Claude Code PostToolUse / PostToolUseFailure hook — capture intermediate failure diffs (#2230)."""
from __future__ import annotations

import json
import os
import sys
import traceback
from pathlib import Path

# Allow `from ifd_capture import …` when invoked as a script path.
sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))

from ifd_capture import handle_hook_payload  # noqa: E402


def os_environ_working_dir() -> Path | None:
    value = (os.environ.get("WORKING_DIR") or os.environ.get("JINN_WORKING_DIR") or "").strip()
    if not value:
        return None
    return Path(value)


def main() -> int:
    try:
        raw = sys.stdin.read()
        if not raw.strip():
            return 0
        payload = json.loads(raw)
        if not isinstance(payload, dict):
            return 0
        working = os_environ_working_dir()
        if working is None:
            print("post-tool-use: WORKING_DIR unset; skip", file=sys.stderr)
            return 0
        handle_hook_payload(payload, working)
    except Exception as exc:  # never fail the Claude session
        print(f"post-tool-use: swallowed error: {exc}", file=sys.stderr)
        traceback.print_exc(file=sys.stderr)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
