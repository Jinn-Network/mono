{
  "name": "@jinn-network/benchmarking-local",
  "version": "0.1.0",
  "description": "Local-venue adapters for benchmarking run assembly ports, including the treatment-fidelity bridge that turns local admission-gate results and Evidence Runtime Observations into per-axis pinning verification. Imports no backend and no evidence package: every venue fact arrives through an injected port.",
  "type": "module",
  "packageManager": "yarn@4.13.0",
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jinn-Network/mono.git",
    "directory": "packages/benchmarking/local"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "pack:smoke": "node scripts/pack-smoke.mjs",
    "prepack": "yarn build"
  },
  "dependencies": {
    "@jinn-network/benchmarking-records": "0.1.0",
    "@jinn-network/benchmarking-run": "0.1.0"
  },
  "resolutions": {
    "@jinn-network/benchmarking-records": "portal:../records",
    "@jinn-network/benchmarking-run": "portal:../run",
    "@jinn-network/benchmarking-testing": "portal:../testing",
    "@jinn-network/task-execution-backend": "portal:../../task-execution/backend",
    "@jinn-network/task-execution-profiles": "portal:../../task-execution/profiles",
    "@jinn-network/task-execution-protocol": "portal:../../task-execution/protocol",
    "@jinn-network/trust-core": "portal:../../trust/core"
  },
  "devDependencies": {
    "@jinn-network/benchmarking-testing": "0.1.0",
    "@jinn-network/task-execution-profiles": "0.1.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
