#!/usr/bin/env sh
# Dev-only thin launcher: exec tsx on the TypeScript entry under src/.
# This file is NOT shipped in the published package (excluded by the
# `files` whitelist in package.json). Published installs use
# dist/bin/jinn.js via the `bin` field instead.
SCRIPT="$0"
while [ -L "$SCRIPT" ]; do
  LINK="$(readlink "$SCRIPT")"
  case "$LINK" in
    /*) SCRIPT="$LINK" ;;
    *) SCRIPT="$(dirname "$SCRIPT")/$LINK" ;;
  esac
done
DIR="$(cd "$(dirname "$SCRIPT")" && pwd)"
exec tsx "$DIR/../src/bin/jinn.ts" "$@"
