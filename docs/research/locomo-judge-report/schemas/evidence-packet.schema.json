{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:colophon:locomo-judge-report:evidence-packet:1",
  "title": "LoCoMo human evidence packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_core_sha256",
    "candidate_sha256",
    "source_dataset_sha256",
    "source_context_sha256",
    "shadow_record_sha256",
    "assistant_status",
    "passages"
  ],
  "properties": {
    "schema_version": {"const": "locomo-evidence-packet@1"},
    "task_core_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_sha256": {"$ref": "#/$defs/sha256"},
    "source_dataset_sha256": {"$ref": "#/$defs/sha256"},
    "source_context_sha256": {"$ref": "#/$defs/sha256"},
    "shadow_record_sha256": {"$ref": "#/$defs/sha256"},
    "assistant_status": {"enum": ["parsed", "schema-invalid", "transport-failed"]},
    "passages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["locator", "content_sha256", "text", "selection_source"],
        "properties": {
          "locator": {"type": "string", "minLength": 1},
          "content_sha256": {"$ref": "#/$defs/sha256"},
          "text": {"type": "string", "minLength": 1},
          "selection_source": {"enum": ["assistant", "predeclared-context", "human-added"]}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
