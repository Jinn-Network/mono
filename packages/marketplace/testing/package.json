{
  "name": "@jinn-network/marketplace-testing",
  "version": "0.1.0",
  "description": "Conformance testing kit for the Jinn marketplace binding tree: the un-parameterized TEP core-kit sanity suite, the natively-authored §16.2 marketplace-profile conformance, projector-determinism + reorg suite, escrow-lifecycle fixtures, and Attempt-URI two-party agreement checks.",
  "type": "module",
  "packageManager": "yarn@4.13.0",
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jinn-Network/mono.git",
    "directory": "packages/marketplace/testing"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./backend-conformance": {
      "import": "./dist/backend-conformance.js",
      "types": "./dist/backend-conformance.d.ts"
    },
    "./named-check-fixtures": {
      "import": "./dist/named-check-fixtures.js",
      "types": "./dist/named-check-fixtures.d.ts"
    },
    "./projector-conformance": {
      "import": "./dist/projector-conformance.js",
      "types": "./dist/projector-conformance.d.ts"
    }
  },
  "files": [
    "dist/",
    "fixtures/",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "pack:smoke": "node scripts/pack-smoke.mjs",
    "prepack": "yarn build"
  },
  "dependencies": {
    "@jinn-network/evidence-protocol": "0.1.0",
    "@jinn-network/marketplace-binding": "0.1.0",
    "@jinn-network/marketplace-projector": "0.1.0",
    "@jinn-network/record-discovery-testing": "0.1.0",
    "@jinn-network/task-execution-testing": "0.1.0",
    "@jinn-network/trust-testing": "0.1.0",
    "viem": "^2.0.0"
  },
  "peerDependencies": {
    "vitest": "^4.1.8"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@jinn-network/record-discovery-protocol": "0.1.0",
    "@jinn-network/record-discovery-serve": "0.1.0",
    "@jinn-network/task-execution-backend": "0.1.0",
    "@jinn-network/task-execution-profiles": "0.1.0",
    "@jinn-network/task-execution-protocol": "0.1.0",
    "@jinn-network/trust-core": "0.1.0",
    "@jinn-network/trust-resolve": "0.1.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  },
  "resolutions": {
    "@jinn-network/evidence-protocol": "portal:../../evidence/protocol",
    "@jinn-network/marketplace-binding": "portal:../binding",
    "@jinn-network/marketplace-projector": "portal:../projector",
    "@jinn-network/record-discovery-protocol": "portal:../../discovery/protocol",
    "@jinn-network/record-discovery-serve": "portal:../../discovery/serve",
    "@jinn-network/record-discovery-testing": "portal:../../discovery/testing",
    "@jinn-network/task-execution-backend": "portal:../../task-execution/backend",
    "@jinn-network/task-execution-profiles": "portal:../../task-execution/profiles",
    "@jinn-network/task-execution-protocol": "portal:../../task-execution/protocol",
    "@jinn-network/task-execution-testing": "portal:../../task-execution/testing",
    "@jinn-network/trust-core": "portal:../../trust/core",
    "@jinn-network/trust-resolve": "portal:../../trust/resolve",
    "@jinn-network/trust-testing": "portal:../../trust/testing"
  }
}
