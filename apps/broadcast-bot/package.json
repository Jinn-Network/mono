{
  "name": "@jinn-network/broadcast-bot",
  "version": "0.1.0",
  "description": "Open-source broadcast bot that posts mechanically-sourced Jinn network state to X. Prose composed by Claude Sonnet 4.6 via the local `claude` CLI; inputs are verifiable on-chain and on-GitHub. Forkable — run your own instance.",
  "type": "module",
  "packageManager": "yarn@4.13.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jinn-Network/mono.git",
    "directory": "apps/broadcast-bot"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "jinn-broadcast": "./dist/bin/jinn-broadcast.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "smol-toml": "^1.8.0",
    "twitter-api-v2": "^1.29.1",
    "viem": "^2.55.19",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.11"
  }
}
