# @jinn-network/indexer — environment template for production deployment.
# Copy to deploy/.env and fill in the values appropriate for your environment.

# ── Postgres ─────────────────────────────────────────────────────────────────
# Required for production. Without this Ponder falls back to PGlite (embedded,
# dev-only). The database should live in the same private network as the
# indexer process — Ponder's docs warn that round-trip latency above 50ms
# causes performance issues.
DATABASE_URL=postgresql://user:password@host:5432/jinn_indexer

# Per-deployment schema isolation. Ponder writes each deployment's tables under
# this schema, which enables the canonical zero-downtime rolling deploy pattern
# (deploy a new version under a new schema, swap views when /ready is 200).
# See deploy/README.md and Ponder's "Self-hosting" docs.
#
# MUST stay versioned (`jinn_indexer_vN`) and MUST NOT equal the views schema
# (`jinn_indexer`). The Dockerfile runs `ponder start --views-schema=jinn_indexer`,
# so setting an unversioned `jinn_indexer` here collides the data schema with the
# views schema and the deploy fails. Bump the suffix (v1 → v2) for a re-sync.
#
# Bumped v1 → v2 (tokenless-OLAS pivot): the `reward_distribution` entity was
# removed (JinnDistributor / JINN-token economy deleted). Removing an entity is
# a breaking schema change per ponder.schema.ts's schema-version policy, so the
# data schema is re-versioned to force a clean re-sync.
DATABASE_SCHEMA=jinn_indexer_v2

# ── RPC endpoints ────────────────────────────────────────────────────────────
# At least one is required depending on which chains this deployment indexes.
# A HyperSync-backed URL (e.g. from Envio) is the fastest option; Ponder treats
# it as a standard JSON-RPC endpoint, so no special config is needed.
PONDER_RPC_URL_84532=https://sepolia.base.org
PONDER_RPC_URL_8453=https://mainnet.base.org

# ── Optional: HTTP port ──────────────────────────────────────────────────────
# Defaults to 42069. Override if a proxy or platform requires a different port.
# PORT=42069

# ── Envelope enrichment ───────────────────────────────────────────────────────
# Set false to skip per-envelope IPFS fetch and sync faster — the explorer's
# harness/mode/plugin/model facets, checkpoint timeline, and freeze integrity
# won't populate.
JINN_INDEXER_ENRICH_ENVELOPES=true
# IPFS gateway for envelope enrichment; default shown (used when unset or empty).
# JINN_IPFS_GATEWAY_URL=https://gateway.autonolas.tech
