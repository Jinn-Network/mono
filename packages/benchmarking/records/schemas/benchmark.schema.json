{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocol": {
      "type": "string",
      "const": "https://jinn.network/protocols/benchmarking/1.0"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "supersedes": {
      "allOf": [
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "uri": {
              "type": "string"
            },
            "digest": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string"
              }
            },
            "mediaType": {
              "type": "string"
            },
            "downloadLocation": {
              "type": "string"
            },
            "annotations": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            },
            "content": {
              "type": "string"
            }
          },
          "additionalProperties": {}
        },
        {
          "type": "object",
          "properties": {
            "digest": {
              "type": "object",
              "properties": {
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "sha256"
              ],
              "additionalProperties": {}
            }
          },
          "required": [
            "digest"
          ],
          "additionalProperties": false
        }
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task": {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "uri": {
                    "type": "string"
                  },
                  "digest": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "mediaType": {
                    "type": "string"
                  },
                  "downloadLocation": {
                    "type": "string"
                  },
                  "annotations": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {}
                  },
                  "content": {
                    "type": "string"
                  }
                },
                "additionalProperties": {}
              },
              {
                "type": "object",
                "properties": {
                  "digest": {
                    "type": "object",
                    "properties": {
                      "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      }
                    },
                    "required": [
                      "sha256"
                    ],
                    "additionalProperties": {}
                  }
                },
                "required": [
                  "digest"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "task"
        ],
        "additionalProperties": false
      }
    },
    "reveal": {
      "type": "object",
      "properties": {
        "policy": {
          "type": "string",
          "enum": [
            "immediate",
            "scheduled",
            "after-run"
          ]
        },
        "notBefore": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        }
      },
      "required": [
        "policy"
      ],
      "additionalProperties": false
    },
    "license": {
      "type": "string"
    },
    "citation": {
      "type": "string"
    }
  },
  "required": [
    "protocol",
    "name",
    "description",
    "version",
    "items",
    "reveal"
  ],
  "additionalProperties": {}
}
