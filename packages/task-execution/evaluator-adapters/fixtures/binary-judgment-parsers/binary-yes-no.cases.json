{
  "parser": {
    "id": "network.jinn.parser.binary-yes-no",
    "version": "1.0.0",
    "digest": "sha256:1b99469a195fee154c27d0c3b219da7778e1b8f4210bd773350d107c459b7949"
  },
  "cases": [
    {
      "case": "empty-output",
      "input": {
        "text": ""
      },
      "expect": {
        "decision": "REJECT",
        "parseValid": false,
        "invalidReason": "unexpected-token"
      }
    },
    {
      "case": "whitespace-only",
      "input": {
        "text": " \t\r\n"
      },
      "expect": {
        "decision": "REJECT",
        "parseValid": false,
        "invalidReason": "unexpected-token"
      }
    },
    {
      "case": "edge-newlines-around-valid-token",
      "input": {
        "text": "\n  YES \r\n"
      },
      "expect": {
        "decision": "ACCEPT",
        "parseValid": true
      }
    },
    {
      "case": "lowercase-token",
      "input": {
        "text": "yes"
      },
      "expect": {
        "decision": "REJECT",
        "parseValid": false,
        "invalidReason": "unexpected-token"
      }
    },
    {
      "case": "interior-whitespace-in-token",
      "input": {
        "text": "YE S"
      },
      "expect": {
        "decision": "REJECT",
        "parseValid": false,
        "invalidReason": "unexpected-token"
      }
    },
    {
      "case": "token-followed-by-period",
      "input": {
        "text": "YES."
      },
      "expect": {
        "decision": "REJECT",
        "parseValid": false,
        "invalidReason": "unexpected-token"
      }
    },
    {
      "case": "token-embedded-in-word",
      "input": {
        "text": "YESTERDAY"
      },
      "expect": {
        "decision": "REJECT",
        "parseValid": false,
        "invalidReason": "unexpected-token"
      }
    },
    {
      "case": "both-tokens-present",
      "input": {
        "text": "YES NO"
      },
      "expect": {
        "decision": "REJECT",
        "parseValid": false,
        "invalidReason": "unexpected-token"
      }
    },
    {
      "case": "bom-prefixing-valid-token",
      "input": {
        "text": "﻿YES"
      },
      "expect": {
        "decision": "REJECT",
        "parseValid": false,
        "invalidReason": "unexpected-token"
      }
    },
    {
      "case": "invalid-utf8",
      "input": {
        "bytesBase64": "/w=="
      },
      "expect": {
        "decision": "REJECT",
        "parseValid": false,
        "invalidReason": "invalid-utf8"
      }
    },
    {
      "case": "truncated-at-generation-cap",
      "input": {
        "text": "The candidate answer restates the reference, so the verdict is YE"
      },
      "expect": {
        "decision": "REJECT",
        "parseValid": false,
        "invalidReason": "unexpected-token"
      }
    },
    {
      "case": "json-object-with-extra-members",
      "input": {
        "text": "{\"verdict\":\"YES\",\"rationale\":\"the candidate matches\"}"
      },
      "expect": {
        "decision": "REJECT",
        "parseValid": false,
        "invalidReason": "unexpected-token"
      }
    },
    {
      "case": "json-inside-code-fence",
      "input": {
        "text": "```json\n{\"verdict\":\"YES\",\"rationale\":\"the candidate matches\"}\n```"
      },
      "expect": {
        "decision": "REJECT",
        "parseValid": false,
        "invalidReason": "unexpected-token"
      }
    },
    {
      "case": "json-array-root",
      "input": {
        "text": "[\"YES\"]"
      },
      "expect": {
        "decision": "REJECT",
        "parseValid": false,
        "invalidReason": "unexpected-token"
      }
    },
    {
      "case": "duplicate-verdict-member",
      "input": {
        "text": "{\"verdict\":\"YES\",\"verdict\":\"NO\"}"
      },
      "expect": {
        "decision": "REJECT",
        "parseValid": false,
        "invalidReason": "unexpected-token"
      }
    }
  ]
}
