{
  "name": "@colophon-claims/core",
  "version": "1.0.0",
  "description": "Core of the standalone benchmark product (internal codename benchmark-product): the Tier 4 product domain — workspace, draft model, lifecycle, audit journal, principals/authority, the operations-library facade, and the CLI agent surface.",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "packageManager": "yarn@4.13.0",
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jinn-Network/mono.git",
    "directory": "packages/benchmark-product/core"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./sample-lifecycle": {
      "import": "./quickstart/sample-lifecycle.mjs",
      "types": "./quickstart/sample-lifecycle.d.ts"
    }
  },
  "files": [
    "dist/",
    "quickstart/ownership.mjs",
    "quickstart/sample-lifecycle.d.ts",
    "quickstart/sample-lifecycle.mjs",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run && node --test scripts/demo1-task-evidence-runner.test.mjs",
    "public-quickstart": "./quickstart/public-quickstart.mjs",
    "publication-release-rehearsal": "COLOPHON_PUBLICATION_RELEASE_REHEARSAL=1 vitest run src/conformance/publication-release-rehearsal.external.test.ts --reporter=verbose",
    "generate:parity": "node scripts/generate-parity-matrix.mjs",
    "check:parity": "node scripts/generate-parity-matrix.mjs --check",
    "p5:fixture:mint": "node scripts/mint-micro-slate.mjs",
    "p5:fixture:check": "node scripts/mint-micro-slate.mjs --check",
    "p5:offline:test": "node --preserve-symlinks --test scripts/p5-disk-gate.test.mjs scripts/p5-disk-reserve.test.mjs scripts/p5-accounting.test.mjs scripts/p5-stop-evidence.test.mjs scripts/p5-walkthrough.test.mjs scripts/mint-micro-slate.test.mjs",
    "p5:green": "node scripts/p5-green-baseline.mjs",
    "p5:walkthrough": "node scripts/p5-walkthrough.mjs",
    "demo1:task-evidence:test": "node --test scripts/demo1-task-evidence-runner.test.mjs",
    "demo1:task-evidence:freeze": "node scripts/demo1-task-evidence-freeze.mjs",
    "demo1:task-evidence:check": "node scripts/demo1-task-evidence-freeze.mjs --check",
    "pack:smoke": "node scripts/pack-smoke.mjs",
    "prepack": "yarn build"
  },
  "dependencies": {
    "@colophon-claims/verify": "1.0.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource-variable/public-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@jinn-network/attestation-issuer": "0.1.0",
    "@jinn-network/benchmarking-aggregate": "0.1.0",
    "@jinn-network/benchmarking-interop": "0.1.0",
    "@jinn-network/benchmarking-local": "0.1.0",
    "@jinn-network/benchmarking-publication": "0.1.0",
    "@jinn-network/benchmarking-records": "0.1.0",
    "@jinn-network/benchmarking-run": "0.1.0",
    "@jinn-network/record-discovery-protocol": "0.1.0",
    "@jinn-network/record-discovery-serve": "0.1.0",
    "@jinn-network/record-discovery-transport-http": "0.1.0",
    "@jinn-network/record-publication": "0.1.0",
    "@jinn-network/task-admission": "0.1.0",
    "@jinn-network/task-execution-backend": "0.1.0",
    "@jinn-network/task-execution-backend-local": "0.1.0",
    "@jinn-network/task-execution-evaluation-harness": "0.1.0",
    "@jinn-network/task-execution-evaluator-adapters": "0.1.0",
    "@jinn-network/task-execution-launchers": "0.1.0",
    "@jinn-network/task-execution-oci-grader": "0.1.0",
    "@jinn-network/task-execution-profiles": "0.1.0",
    "@jinn-network/task-execution-protocol": "0.1.0",
    "@jinn-network/task-execution-supervisor": "0.1.0",
    "@jinn-network/task-execution-workspace": "0.1.0",
    "@jinn-network/trust-core": "0.1.0",
    "zod": "4.4.3"
  },
  "resolutions": {
    "@colophon-claims/verify": "portal:../verify",
    "@jinn-network/attestation-issuer": "portal:../../evidence/attestation-issuer",
    "@jinn-network/benchmarking-aggregate": "portal:../../benchmarking/aggregate",
    "@jinn-network/benchmarking-interop": "portal:../../benchmarking/interop",
    "@jinn-network/benchmarking-local": "portal:../../benchmarking/local",
    "@jinn-network/benchmarking-publication": "portal:../../benchmarking/publication",
    "@jinn-network/record-publication": "portal:../../discovery/publication",
    "@jinn-network/record-discovery-protocol": "portal:../../discovery/protocol",
    "@jinn-network/record-discovery-client": "portal:../../discovery/client",
    "@jinn-network/record-discovery-serve": "portal:../../discovery/serve",
    "@jinn-network/record-discovery-transport-http": "portal:../../discovery/transport-http",
    "@jinn-network/benchmarking-records": "portal:../../benchmarking/records",
    "@jinn-network/benchmarking-run": "portal:../../benchmarking/run",
    "@jinn-network/environment-record": "portal:../../environments/record",
    "@jinn-network/evidence-discovery": "portal:../../evidence/discovery",
    "@jinn-network/evidence-protocol": "portal:../../evidence/protocol",
    "@jinn-network/evidence-repository": "portal:../../evidence/repository",
    "@jinn-network/execution-recorder": "portal:../../evidence/execution-recorder",
    "@jinn-network/task-admission": "portal:../../task-supply/admission",
    "@jinn-network/task-execution-backend": "portal:../../task-execution/backend",
    "@jinn-network/task-execution-backend-local": "portal:../../task-execution/backend-local/assembly",
    "@jinn-network/task-execution-evaluation-harness": "portal:../../task-execution/evaluation-harness",
    "@jinn-network/task-execution-evaluator-adapters": "portal:../../task-execution/evaluator-adapters",
    "@jinn-network/task-execution-launchers": "portal:../../task-execution/backend-local/launchers",
    "@jinn-network/task-execution-oci-grader": "portal:../../task-execution/oci-grader",
    "@jinn-network/task-execution-profiles": "portal:../../task-execution/profiles",
    "@jinn-network/task-execution-protocol": "portal:../../task-execution/protocol",
    "@jinn-network/task-execution-supervisor": "portal:../../task-execution/backend-local/supervisor",
    "@jinn-network/task-execution-workspace": "portal:../../task-execution/backend-local/workspace",
    "@jinn-network/trust-core": "portal:../../trust/core"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
