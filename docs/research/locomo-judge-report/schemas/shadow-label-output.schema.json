{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:colophon:locomo-judge-report:shadow-label-output:1",
  "title": "LoCoMo shadow evidence-assistant output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_core_sha256",
    "candidate_sha256",
    "source_context_sha256",
    "evidence_locators",
    "essential_facts",
    "released_key_status",
    "provisional_label",
    "rationale",
    "uncertainty",
    "uncertainty_reasons"
  ],
  "properties": {
    "schema_version": {"const": "shadow-label-output@1"},
    "task_core_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_sha256": {"$ref": "#/$defs/sha256"},
    "source_context_sha256": {"$ref": "#/$defs/sha256"},
    "evidence_locators": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["locator", "relation", "fact"],
        "properties": {
          "locator": {"type": "string", "minLength": 1},
          "relation": {"enum": ["supports-reference", "supports-candidate", "contradicts-candidate", "resolves-context"]},
          "fact": {"type": "string", "minLength": 1}
        }
      }
    },
    "essential_facts": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "released_key_status": {"enum": ["verified", "incomplete", "incorrect", "indeterminate"]},
    "provisional_label": {"enum": ["accept", "reject", "indeterminate"]},
    "rationale": {"type": "string", "minLength": 1},
    "uncertainty": {"enum": ["low", "medium", "high"]},
    "uncertainty_reasons": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
