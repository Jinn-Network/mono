{
  "parser": {
    "id": "network.jinn.parser.binary-json-verdict",
    "version": "1.0.0",
    "digest": "sha256:543a71887f3ae95b0aede4513af3fdeadfc706c7a86f93452e3272d7ccdd2201"
  },
  "cases": [
    {
      "case": "empty-output",
      "input": {
        "text": ""
      },
      "expect": {
        "decision": "REJECT",
        "parseValid": false,
        "invalidReason": "unexpected-token"
      }
    },
    {
      "case": "whitespace-only",
      "input": {
        "text": " \t\r\n"
      },
      "expect": {
        "decision": "REJECT",
        "parseValid": false,
        "invalidReason": "unexpected-token"
      }
    },
    {
      "case": "edge-newlines-around-valid-token",
      "input": {
        "text": "\n  {\"verdict\":\"ACCEPT\"}  \r\n"
      },
      "expect": {
        "decision": "ACCEPT",
        "parseValid": true
      }
    },
    {
      "case": "lowercase-token",
      "input": {
        "text": "{\"verdict\":\"accept\"}"
      },
      "expect": {
        "decision": "REJECT",
        "parseValid": false,
        "invalidReason": "unexpected-token"
      }
    },
    {
      "case": "interior-whitespace-in-token",
      "input": {
        "text": "{\"verdict\":\"ACC EPT\"}"
      },
      "expect": {
        "decision": "REJECT",
        "parseValid": false,
        "invalidReason": "unexpected-token"
      }
    },
    {
      "case": "both-tokens-present",
      "input": {
        "text": "{\"verdict\":\"ACCEPT REJECT\"}"
      },
      "expect": {
        "decision": "REJECT",
        "parseValid": false,
        "invalidReason": "unexpected-token"
      }
    },
    {
      "case": "bom-prefixing-valid-token",
      "input": {
        "text": "﻿{\"verdict\":\"ACCEPT\"}"
      },
      "expect": {
        "decision": "REJECT",
        "parseValid": false,
        "invalidReason": "unexpected-token"
      }
    },
    {
      "case": "invalid-utf8",
      "input": {
        "bytesBase64": "/w=="
      },
      "expect": {
        "decision": "REJECT",
        "parseValid": false,
        "invalidReason": "invalid-utf8"
      }
    },
    {
      "case": "truncated-at-generation-cap",
      "input": {
        "text": "{\"verdict\":\"ACCE"
      },
      "expect": {
        "decision": "REJECT",
        "parseValid": false,
        "invalidReason": "unexpected-token"
      }
    },
    {
      "case": "json-object-with-extra-members",
      "input": {
        "text": "{\"verdict\":\"ACCEPT\",\"rationale\":\"the candidate matches\"}"
      },
      "expect": {
        "decision": "ACCEPT",
        "parseValid": true
      }
    },
    {
      "case": "json-inside-code-fence",
      "input": {
        "text": "```json\n{\"verdict\":\"ACCEPT\",\"rationale\":\"the candidate matches\"}\n```"
      },
      "expect": {
        "decision": "REJECT",
        "parseValid": false,
        "invalidReason": "unexpected-token"
      }
    },
    {
      "case": "json-array-root",
      "input": {
        "text": "[\"ACCEPT\"]"
      },
      "expect": {
        "decision": "REJECT",
        "parseValid": false,
        "invalidReason": "unexpected-token"
      }
    },
    {
      "case": "duplicate-verdict-member",
      "input": {
        "text": "{\"verdict\":\"ACCEPT\",\"verdict\":\"REJECT\"}"
      },
      "expect": {
        "decision": "REJECT",
        "parseValid": false,
        "invalidReason": "unexpected-token"
      }
    }
  ]
}
