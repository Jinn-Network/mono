{
  "name": "@jinn-network/operator-console",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@4.13.0",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build --webpack",
    "start": "next start --port 3000",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test lib/*.test.ts test/*.test.mjs",
    "e2e": "playwright test --config=playwright.config.ts",
    "e2e:app-flow": "playwright test --config=playwright.config.ts e2e/claim-policy-flow.e2e.ts e2e/posting-status.e2e.ts",
    "e2e:funding-sequence": "playwright test --config=playwright.config.ts e2e/funding-sequence.e2e.ts"
  },
  "dependencies": {
    "@jinn-network/lifecycle-notifications": "portal:../../packages/lifecycle-notifications",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "next": "16.3.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.24",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.5",
    "typescript": "^6.0.3"
  }
}
