import { describe, it, expect } from 'vitest';
import createHarness from '../src/index.js';
import type {
  ExternalHarnessEnv,
  HarnessContext,
} from '@jinn-network/sdk/harness';

const env: ExternalHarnessEnv = {
  implName: '{{packageName}}',
  implVersion: '0.1.0',
  network: '{{network}}',
  implStateDir: '/tmp/{{packageNameSlug}}',
  secrets: Object.freeze({}),
  log: () => {},
  stub: false,
};

const ctx: HarnessContext = {
  task: { id: 'test', description: 'test', solverType: '{{solverTypeString}}', spec: {} },
  taskCid: undefined,
  implStateDir: '/tmp/{{packageNameSlug}}',
  workingDir: '/tmp/{{packageNameSlug}}-work',
  log: () => {},
  abort: new AbortController().signal,
  msUntilEndTs: () => 60_000,
  trajectory: { addSpan: () => ({}) },
};

describe('{{packageName}}', () => {
  it('supports the configured SolverType', () => {
    const impl = createHarness(env);
    expect(impl.supports({ solverType: '{{solverTypeString}}' })).toBe(true);
    expect(impl.supports({ solverType: 'other.v0' })).toBe(false);
  });

  it('produces a Solution with a probability', async () => {
    const impl = createHarness(env);
    const out = await impl.run(ctx);
    expect(out.gating).toHaveProperty('probability');
    expect(typeof out.gating.probability).toBe('number');
  });
});
