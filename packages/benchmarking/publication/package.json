{
  "name": "@jinn-network/benchmarking-publication",
  "version": "0.1.0",
  "description": "Reusable benchmark-publication accounting, verification, and neutral publication planning.",
  "type": "module",
  "packageManager": "yarn@4.13.0",
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jinn-Network/mono.git",
    "directory": "packages/benchmarking/publication"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "pack:smoke": "node scripts/pack-smoke.mjs",
    "prepack": "yarn build"
  },
  "dependencies": {
    "@jinn-network/benchmarking-records": "0.1.0",
    "@jinn-network/record-publication": "0.1.0",
    "@jinn-network/task-execution-protocol": "0.1.0"
  },
  "resolutions": {
    "@jinn-network/benchmarking-records": "portal:../records",
    "@jinn-network/record-publication": "portal:../../discovery/publication",
    "@jinn-network/task-execution-protocol": "portal:../../task-execution/protocol",
    "@jinn-network/record-discovery-protocol": "portal:../../discovery/protocol",
    "@jinn-network/record-discovery-serve": "portal:../../discovery/serve",
    "@jinn-network/trust-core": "portal:../../trust/core"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
