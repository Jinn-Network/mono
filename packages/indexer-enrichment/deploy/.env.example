# @jinn-network/indexer-enrichment — deploy env (#779).
# Shared with the indexer: the worker writes into the indexer's Ponder schema.

# Required — the SAME Postgres + schema the indexer uses.
DATABASE_URL=postgres://user:password@host:5432/railway
DATABASE_SCHEMA=jinn_indexer_v1

# Shared IPFS gateway (empty → https://gateway.autonolas.tech).
JINN_IPFS_GATEWAY_URL=

# Worker knobs (optional — defaults shown).
JINN_ENRICHMENT_PORT=8738
JINN_ENRICHMENT_POLL_INTERVAL_MS=10000
# O4 backfill-drain knob: anchors enriched per tick. Tune down on first deploy
# to avoid an IPFS-gateway / Postgres write storm draining the historical backlog.
JINN_ENRICHMENT_BATCH_SIZE=25
JINN_ENRICHMENT_IPFS_TIMEOUT_MS=5000
JINN_ENRICHMENT_MAX_RETRIES=5
