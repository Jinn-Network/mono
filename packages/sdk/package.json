{
  "name": "@jinn-network/sdk",
  "version": "0.2.0",
  "description": "Stable SDK surface for Jinn SolverNets, Harnesses, plugins, and typed payloads.",
  "type": "module",
  "packageManager": "yarn@4.13.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jinn-Network/mono.git",
    "directory": "packages/sdk"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./harness": {
      "import": "./dist/harness.js",
      "types": "./dist/harness.d.ts"
    },
    "./plugins": {
      "import": "./dist/plugins.js",
      "types": "./dist/plugins.d.ts"
    },
    "./solvernets": {
      "import": "./dist/solvernets/index.js",
      "types": "./dist/solvernets/index.d.ts"
    },
    "./solvernets/prediction-v1": {
      "import": "./dist/solvernets/prediction-v1.js",
      "types": "./dist/solvernets/prediction-v1.d.ts"
    },
    "./solvernets/swe-rebench-v2": {
      "import": "./dist/solvernets/swe-rebench-v2.js",
      "types": "./dist/solvernets/swe-rebench-v2.d.ts"
    },
    "./solvernets/jinn-repo": {
      "import": "./dist/solvernets/jinn-repo.js",
      "types": "./dist/solvernets/jinn-repo.d.ts"
    },
    "./autopilot": {
      "import": "./dist/autopilot.js",
      "types": "./dist/autopilot.d.ts"
    },
    "./fixtures/autopilot/*": "./fixtures/autopilot/*",
    "./solvernets/swe-rebench-v2-held-out-slate": {
      "import": "./dist/solvernets/swe-rebench-v2-held-out-slate.js",
      "types": "./dist/solvernets/swe-rebench-v2-held-out-slate.d.ts"
    },
    "./checkpoint": {
      "import": "./dist/checkpoint.js",
      "types": "./dist/checkpoint.d.ts"
    }
  },
  "files": [
    "dist/",
    "fixtures/",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "yarn build && yarn test",
    "pack:smoke": "yarn pack -o jinn-sdk.tgz && node scripts/smoke-test-pack.mjs",
    "release:sdk": "node scripts/release-sdk.mjs"
  },
  "dependencies": {
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.8"
  }
}
