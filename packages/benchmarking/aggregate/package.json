{
  "name": "@jinn-network/benchmarking-aggregate",
  "version": "0.1.0",
  "description": "Consumer-side aggregation for the Jinn benchmarking application: the method registry, reference statistics, and Report production/verification.",
  "type": "module",
  "packageManager": "yarn@4.13.0",
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jinn-Network/mono.git",
    "directory": "packages/benchmarking/aggregate"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "pack:smoke": "node scripts/pack-smoke.mjs",
    "prepack": "yarn build"
  },
  "dependencies": {
    "@jinn-network/benchmarking-records": "0.1.0",
    "@jinn-network/trust-core": "0.1.0"
  },
  "resolutions": {
    "@jinn-network/benchmarking-records": "portal:../records",
    "@jinn-network/task-execution-protocol": "portal:../../task-execution/protocol",
    "@jinn-network/trust-core": "portal:../../trust/core"
  },
  "devDependencies": {
    "@jinn-network/task-execution-protocol": "0.1.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
