{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocol": {
      "type": "string",
      "const": "https://spec.jinn.network/protocols/benchmarking/v1"
    },
    "benchmark": {
      "allOf": [
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "uri": {
              "type": "string"
            },
            "digest": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string"
              }
            },
            "mediaType": {
              "type": "string"
            },
            "downloadLocation": {
              "type": "string"
            },
            "annotations": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            },
            "content": {
              "type": "string"
            }
          },
          "additionalProperties": {}
        },
        {
          "type": "object",
          "properties": {
            "digest": {
              "type": "object",
              "properties": {
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "sha256"
              ],
              "additionalProperties": {}
            }
          },
          "required": [
            "digest"
          ],
          "additionalProperties": {}
        }
      ]
    },
    "owner": {
      "type": "string"
    },
    "arms": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "armId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "pinning": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "execution": {
            "type": "object",
            "properties": {
              "allowlist": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "allowlist"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "armId",
          "pinning"
        ],
        "additionalProperties": false
      }
    },
    "replicates": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "policy": {
      "type": "object",
      "properties": {
        "completenessFloor": {
          "type": "string",
          "pattern": "^(?:0*1(?:\\.0+)?|0*0\\.(?:0*[1-9]\\d*))$",
          "$comment": "Runtime check: exact BigInt completeness comparison."
        },
        "cellWindow": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "replacement": {
          "type": "object",
          "properties": {
            "allowed": {
              "type": "boolean"
            },
            "maxPerCell": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "allowed"
          ],
          "additionalProperties": false
        },
        "independence": {
          "type": "string",
          "enum": [
            "gating",
            "disclosed"
          ]
        },
        "evaluation": {
          "type": "object",
          "properties": {
            "minVerdicts": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "distinctEvaluator": {
              "type": "boolean"
            },
            "maxInfrastructureRetries": {
              "anyOf": [
                {
                  "type": "number",
                  "const": 0
                },
                {
                  "type": "number",
                  "const": 1
                }
              ]
            }
          },
          "additionalProperties": false
        },
        "submissionBaseline": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "participantExclusions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "completenessFloor",
        "cellWindow",
        "replacement",
        "independence",
        "evaluation",
        "submissionBaseline"
      ],
      "additionalProperties": false
    },
    "analysisPlan": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "parameters": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "method",
          "version",
          "parameters"
        ],
        "additionalProperties": false
      }
    },
    "budget": {
      "type": "object",
      "properties": {
        "perCell": {
          "type": "object",
          "properties": {
            "solve": {
              "type": "string",
              "pattern": "^\\d+(\\.\\d+)?$"
            },
            "evaluate": {
              "type": "string",
              "pattern": "^\\d+(\\.\\d+)?$"
            }
          },
          "required": [
            "solve",
            "evaluate"
          ],
          "additionalProperties": false
        },
        "hardCap": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d+)?$"
        },
        "unit": {
          "type": "string"
        }
      },
      "required": [
        "perCell",
        "hardCap",
        "unit"
      ],
      "additionalProperties": false
    },
    "venue": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "self-run",
            "open-competition"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "closeAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "protocol",
    "benchmark",
    "owner",
    "arms",
    "replicates",
    "policy",
    "closeAt"
  ],
  "additionalProperties": {},
  "propertyNames": {
    "anyOf": [
      {
        "enum": [
          "protocol",
          "benchmark",
          "owner",
          "arms",
          "replicates",
          "policy",
          "analysisPlan",
          "budget",
          "venue",
          "closeAt"
        ]
      },
      {
        "pattern": "^(?:[A-Za-z][A-Za-z0-9-]*(?:\\.[A-Za-z][A-Za-z0-9-]*)+|[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+)$"
      }
    ]
  },
  "$comment": "Runtime checks: cross-record references, canonical byte equality, and Matrix/Run cross-field invariants.",
  "$id": "https://spec.jinn.network/protocols/benchmarking/v1/schemas/run.schema.json"
}
