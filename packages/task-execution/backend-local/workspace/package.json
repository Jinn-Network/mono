{
  "name": "@jinn-network/task-execution-workspace",
  "version": "0.1.0",
  "description": "The Workspace Provisioner: the per-attempt directory contract, two-phase provisioning, input materialization, and the symlink-guarded verified-empty harvest for the Jinn Task Execution Protocol local backend. Depends on @jinn-network/task-execution-protocol and @jinn-network/task-execution-profiles.",
  "type": "module",
  "packageManager": "yarn@4.13.0",
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jinn-Network/mono.git",
    "directory": "packages/task-execution/backend-local/workspace"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "pack:smoke": "node scripts/pack-smoke.mjs",
    "prepack": "yarn build"
  },
  "dependencies": {
    "@jinn-network/task-execution-profiles": "0.1.0",
    "@jinn-network/task-execution-protocol": "0.1.0"
  },
  "devDependencies": {
    "@jinn-network/task-execution-backend": "0.1.0",
    "@jinn-network/task-execution-testing": "0.1.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  },
  "resolutions": {
    "@jinn-network/evidence-discovery": "portal:../../../evidence/discovery",
    "@jinn-network/evidence-protocol": "portal:../../../evidence/protocol",
    "@jinn-network/evidence-repository": "portal:../../../evidence/repository",
    "@jinn-network/execution-recorder": "portal:../../../evidence/execution-recorder",
    "@jinn-network/task-execution-backend": "portal:../../backend",
    "@jinn-network/task-execution-backend-local": "portal:../assembly",
    "@jinn-network/task-execution-launchers": "portal:../launchers",
    "@jinn-network/task-execution-profiles": "portal:../../profiles",
    "@jinn-network/task-execution-protocol": "portal:../../protocol",
    "@jinn-network/task-execution-supervisor": "portal:../supervisor",
    "@jinn-network/task-execution-testing": "portal:../../testing"
  }
}
