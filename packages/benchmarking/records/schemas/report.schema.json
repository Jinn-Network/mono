{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocol": {
      "type": "string",
      "const": "https://jinn.network/protocols/benchmarking/1.0"
    },
    "subjects": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "uri": {
            "type": "string"
          },
          "digest": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "mediaType": {
            "type": "string"
          },
          "downloadLocation": {
            "type": "string"
          },
          "annotations": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "content": {
            "type": "string"
          }
        },
        "additionalProperties": {}
      }
    },
    "method": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "parameters": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "id",
        "version",
        "parameters"
      ],
      "additionalProperties": false
    },
    "preregistered": {
      "type": "boolean"
    },
    "results": {},
    "disclosures": {
      "type": "object",
      "properties": {
        "integrityTiers": {
          "type": "object",
          "properties": {
            "re-derivable": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "attested-only": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "re-derivable",
            "attested-only"
          ],
          "additionalProperties": false
        },
        "pinning": {
          "type": "object",
          "properties": {
            "harness": {
              "type": "object",
              "properties": {
                "match": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "mismatch": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "unverifiable": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "match",
                "mismatch",
                "unverifiable"
              ],
              "additionalProperties": false
            },
            "model": {
              "type": "object",
              "properties": {
                "match": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "mismatch": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "unverifiable": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "match",
                "mismatch",
                "unverifiable"
              ],
              "additionalProperties": false
            },
            "loadout": {
              "type": "object",
              "properties": {
                "match": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "mismatch": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "unverifiable": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "match",
                "mismatch",
                "unverifiable"
              ],
              "additionalProperties": false
            },
            "isolation": {
              "type": "object",
              "properties": {
                "match": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "mismatch": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "unverifiable": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "match",
                "mismatch",
                "unverifiable"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "harness",
            "model",
            "loadout",
            "isolation"
          ],
          "additionalProperties": false
        },
        "independence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "completeness": {
          "type": "object",
          "properties": {
            "expected": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "judged": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "floor": {
              "type": "string",
              "pattern": "^\\d+(\\.\\d+)?$"
            },
            "runOutcome": {
              "type": "string",
              "enum": [
                "complete",
                "partial",
                "cancelled"
              ]
            }
          },
          "required": [
            "expected",
            "judged",
            "floor",
            "runOutcome"
          ],
          "additionalProperties": false
        },
        "attrition": {
          "type": "object",
          "properties": {
            "asymmetryFlags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "perArm": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "nonJudged": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "nonJudged"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "asymmetryFlags",
            "perArm"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "integrityTiers",
        "pinning",
        "independence",
        "completeness",
        "attrition"
      ],
      "additionalProperties": false
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "author": {
      "type": "string"
    }
  },
  "required": [
    "protocol",
    "subjects",
    "method",
    "results",
    "author"
  ],
  "additionalProperties": {}
}
