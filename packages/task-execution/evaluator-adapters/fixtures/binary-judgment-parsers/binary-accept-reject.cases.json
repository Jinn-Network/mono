{
  "parser": {
    "id": "network.jinn.parser.binary-accept-reject",
    "version": "1.0.0",
    "digest": "sha256:02aa652770de9e74415cd206c8741b6148e3ea82c21773983a6d8c66030d0073"
  },
  "cases": [
    {
      "case": "empty-output",
      "input": {
        "text": ""
      },
      "expect": {
        "decision": "REJECT",
        "parseValid": false,
        "invalidReason": "unexpected-token"
      }
    },
    {
      "case": "whitespace-only",
      "input": {
        "text": " \t\r\n"
      },
      "expect": {
        "decision": "REJECT",
        "parseValid": false,
        "invalidReason": "unexpected-token"
      }
    },
    {
      "case": "edge-newlines-around-valid-token",
      "input": {
        "text": "\n  ACCEPT \r\n"
      },
      "expect": {
        "decision": "ACCEPT",
        "parseValid": true
      }
    },
    {
      "case": "lowercase-token",
      "input": {
        "text": "accept"
      },
      "expect": {
        "decision": "REJECT",
        "parseValid": false,
        "invalidReason": "unexpected-token"
      }
    },
    {
      "case": "interior-whitespace-in-token",
      "input": {
        "text": "ACC EPT"
      },
      "expect": {
        "decision": "REJECT",
        "parseValid": false,
        "invalidReason": "unexpected-token"
      }
    },
    {
      "case": "token-followed-by-period",
      "input": {
        "text": "ACCEPT."
      },
      "expect": {
        "decision": "REJECT",
        "parseValid": false,
        "invalidReason": "unexpected-token"
      }
    },
    {
      "case": "token-embedded-in-word",
      "input": {
        "text": "ACCEPTABLE"
      },
      "expect": {
        "decision": "REJECT",
        "parseValid": false,
        "invalidReason": "unexpected-token"
      }
    },
    {
      "case": "both-tokens-present",
      "input": {
        "text": "ACCEPT REJECT"
      },
      "expect": {
        "decision": "REJECT",
        "parseValid": false,
        "invalidReason": "unexpected-token"
      }
    },
    {
      "case": "bom-prefixing-valid-token",
      "input": {
        "text": "﻿ACCEPT"
      },
      "expect": {
        "decision": "REJECT",
        "parseValid": false,
        "invalidReason": "unexpected-token"
      }
    },
    {
      "case": "invalid-utf8",
      "input": {
        "bytesBase64": "/w=="
      },
      "expect": {
        "decision": "REJECT",
        "parseValid": false,
        "invalidReason": "invalid-utf8"
      }
    },
    {
      "case": "truncated-at-generation-cap",
      "input": {
        "text": "The candidate answer restates the reference, so the verdict is ACCE"
      },
      "expect": {
        "decision": "REJECT",
        "parseValid": false,
        "invalidReason": "unexpected-token"
      }
    },
    {
      "case": "json-object-with-extra-members",
      "input": {
        "text": "{\"verdict\":\"ACCEPT\",\"rationale\":\"the candidate matches\"}"
      },
      "expect": {
        "decision": "REJECT",
        "parseValid": false,
        "invalidReason": "unexpected-token"
      }
    },
    {
      "case": "json-inside-code-fence",
      "input": {
        "text": "```json\n{\"verdict\":\"ACCEPT\",\"rationale\":\"the candidate matches\"}\n```"
      },
      "expect": {
        "decision": "REJECT",
        "parseValid": false,
        "invalidReason": "unexpected-token"
      }
    },
    {
      "case": "json-array-root",
      "input": {
        "text": "[\"ACCEPT\"]"
      },
      "expect": {
        "decision": "REJECT",
        "parseValid": false,
        "invalidReason": "unexpected-token"
      }
    },
    {
      "case": "duplicate-verdict-member",
      "input": {
        "text": "{\"verdict\":\"ACCEPT\",\"verdict\":\"REJECT\"}"
      },
      "expect": {
        "decision": "REJECT",
        "parseValid": false,
        "invalidReason": "unexpected-token"
      }
    }
  ]
}
