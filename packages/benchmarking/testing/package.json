{
  "name": "@jinn-network/benchmarking-testing",
  "version": "0.1.0",
  "description": "Conformance kit for the Jinn benchmarking application: record, method, assembly, ordering, and export conformance drivers plus golden fixtures.",
  "type": "module",
  "packageManager": "yarn@4.13.0",
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jinn-Network/mono.git",
    "directory": "packages/benchmarking/testing"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./fixtures/*": "./fixtures/*"
  },
  "files": [
    "dist/",
    "fixtures/",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "pack:smoke": "node scripts/pack-smoke.mjs",
    "prepack": "yarn build"
  },
  "dependencies": {
    "@jinn-network/benchmarking-records": "0.1.0",
    "@jinn-network/task-execution-profiles": "0.1.0",
    "@jinn-network/task-execution-protocol": "0.1.0"
  },
  "resolutions": {
    "@jinn-network/benchmarking-aggregate": "portal:../aggregate",
    "@jinn-network/benchmarking-records": "portal:../records",
    "@jinn-network/task-execution-profiles": "portal:../../task-execution/profiles",
    "@jinn-network/task-execution-protocol": "portal:../../task-execution/protocol",
    "@jinn-network/trust-core": "portal:../../trust/core"
  },
  "peerDependencies": {
    "vitest": "^4.1.8"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@jinn-network/benchmarking-aggregate": "0.1.0",
    "@jinn-network/trust-core": "0.1.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
