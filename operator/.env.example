# Base mainnet RPC URL. Public mainnet.base.org is unreliable — use a paid
# provider (Tenderly, Alchemy, etc.). Required for e2e tests and any code
# path that forks Base mainnet (CI Tier 1 T1.1 spawns Anvil from this URL).
# Not currently used by the Ponder indexer — Base mainnet indexing isn't
# enabled yet (see packages/indexer/ponder.config.ts §"Base mainnet (8453)
# is intentionally NOT indexed yet" — jinn-mono-280n.4).
BASE_RPC_URL=https://base.gateway.tenderly.co/YOUR_KEY_HERE

# Base Sepolia RPC URL — Tenderly gateway. Slots into position 3 of the
# multi-RPC fallback chain designed in #592 (publicnode → Envio HyperSync
# → THIS → sepolia.base.org). Engaged only when publicnode + Envio both
# error, so this reserves Tenderly's monthly quota for genuine emergencies.
# Operators with their own Tenderly key can paste it here; default daemon
# operates on free public RPCs with no Tenderly required.
BASE_SEPOLIA_RPC_URL=https://base-sepolia.gateway.tenderly.co/YOUR_KEY_HERE

# Envio HyperSync API token — required since 2025-11-03.
# Generate one at https://envio.dev/app-tokens (free, 2 min).
# Slots into position 1 of the indexer's RPC fallback chain (#592) —
# HyperSync is 1000-2000x faster than standard JSON-RPC for event
# indexing, which is what Ponder does. The Ponder transport wires
# this token as `Authorization: Bearer ${ENVIO_API_TOKEN}` in the
# viem http() fetchOptions. Operator daemon does NOT need this token
# (publicnode is sufficient for the daemon's RPC patterns); it's only
# needed for the project-managed Ponder indexer deployment.
# ENVIO_API_TOKEN=envio_xxxxxxxxxxxxxxxx

# Optional Base Sepolia proof/archive RPC for canonical verifier-only canaries.
# Normal burn-in uses MockMessenger; this endpoint is only for historical
# eth_getProof at OP dispute-game L2 blocks.
# JINN_L2_PROOF_RPC_URL=https://base-sepolia-archive.example/YOUR_KEY_HERE

# Sepolia L1 RPC URL. Only needed by protocol-team scripts that bridge JINN
# from L1 to L2 (see contracts/scripts/README-jinn-testnet-faucet.md).
# Operator-side relayer + L1↔L2 loop default to the public
# ethereum-sepolia-rpc.publicnode.com endpoint and don't need this set.
# SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY_HERE

# Keystore password. Env-only — do not put in a config file.
# JINN_PASSWORD=your-secure-password

# Testnet contract deployment overrides. The client ships bundled copies in
# operator/deployments/ and auto-resolves them regardless of cwd, so operators
# do NOT need to set these. Only override (with ABSOLUTE paths) when pointing
# at a non-standard deployment during protocol-team development.
# JINN_TESTNET_TOKEN_DEPLOYMENT=/absolute/path/to/deployment-phase1a-token-baseSepolia-fast.json
# JINN_TESTNET_L2_DEPLOYMENT=/absolute/path/to/deployment-phase1a-l2-baseSepolia-fast.json
# JINN_TESTNET_MECH_DEPLOYMENT=/absolute/path/to/deployment-phase1b-mech-baseSepolia-fast.json
