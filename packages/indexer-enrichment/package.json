{
  "name": "@jinn-network/indexer-enrichment",
  "version": "0.1.0",
  "description": "Standalone polling worker that off-loads IPFS-bound verdict-envelope enrichment off the Ponder indexer's GraphQL event loop (#779)",
  "type": "module",
  "packageManager": "yarn@4.13.0",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "jinn-indexer-enrichment": "./dist/index.js"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@jinn-network/indexer": "portal:../indexer",
    "drizzle-orm": "0.45.2",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.2",
    "@types/node": "^25.9.3",
    "@types/pg": "^8.15.0",
    "tsx": "^4.22.4",
    "typescript": "^5.4.0",
    "vitest": "^4.1.8"
  }
}
