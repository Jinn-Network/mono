{
  "name": "@jinn-network/indexer-enrichment",
  "version": "0.1.0",
  "description": "Standalone polling worker that off-loads IPFS-bound verdict-envelope enrichment off the Ponder indexer's GraphQL event loop (#779)",
  "type": "module",
  "packageManager": "yarn@4.13.0",
  "license": "MIT",
  "main": "./dist/index.js",
  "bin": {
    "jinn-indexer-enrichment": "./dist/index.js"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@jinn-network/indexer": "portal:../indexer",
    "drizzle-orm": "0.45.2",
    "pg": "^8.23.0"
  },
  "resolutions": {
    "@jinn-network/task-execution-protocol": "portal:../task-execution/protocol",
    "@jinn-network/trust-core": "portal:../trust/core"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@types/node": "^25.9.5",
    "@types/pg": "^8.21.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.12",
    "typescript": "^5.4.0",
    "vitest": "^4.1.10"
  }
}
